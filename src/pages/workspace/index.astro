---
import WorkspaceShell from '../../workspace/components/WorkspaceShell.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GameBob Quest - Pipeline Workspace</title>
    <style is:global>
      :root {
        --font-family: -apple-system, "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", sans-serif;
        --font-mono: ui-monospace, "SFMono-Regular", "Segoe UI Mono", "Menlo", "Monaco", "Consolas", monospace;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html, body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        font-family: var(--font-family);
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border-width: 0;
      }
    </style>
  </head>
  <body>
    <h1 class="sr-only">GameBob Quest Pipeline Workspace</h1>
    <WorkspaceShell productName="GameBob Quest" />
  </body>
</html>
