---
import { SEORenderer } from '@jjlmoya/utils-shared';
import { pixelArtPaletteSwapper } from './entry';
import type { KnownLocale } from '../../types';

interface Props {
  locale?: KnownLocale;
}

const { locale = 'en' } = Astro.props;
const loader = pixelArtPaletteSwapper.i18n[locale] ?? pixelArtPaletteSwapper.i18n.en;
const content = loader ? await loader() : null;
---

{content && content.seo.length > 0 && <SEORenderer content={{ locale, sections: content.seo }} />}
