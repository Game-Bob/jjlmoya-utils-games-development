---
import type { KnownLocale } from '../../types';
import type { BaseballScoreKeeperUI } from './ui';

interface Props {
  locale?: KnownLocale;
  ui?: Record<string, unknown>;
}

const { ui } = Astro.props;
const t = (ui ?? {}) as BaseballScoreKeeperUI;
---

<div class="bb-app" id="bb-app" data-bb-ui={JSON.stringify(t)}>

  <div class="bb-strip">
    <div class="bb-team">
      <input type="text" class="bb-name" id="bb-name-away" value={t.away} />
      <div class="bb-score" id="bb-score-away">0</div>
    </div>
    <div class="bb-divider">
      <span class="bb-inning-badge" id="bb-inning-label">Top 1</span>
    </div>
    <div class="bb-team">
      <input type="text" class="bb-name" id="bb-name-home" value={t.home} />
      <div class="bb-score" id="bb-score-home">0</div>
    </div>
  </div>

  <div class="bb-count-row">
    <div class="bb-count-item">
      <span class="bb-count-label">{t.balls}</span>
      <div class="bb-dots" id="bb-dots-balls">
        <span class="bb-dot"></span><span class="bb-dot"></span><span class="bb-dot"></span><span class="bb-dot"></span>
      </div>
    </div>
    <div class="bb-count-item">
      <span class="bb-count-label">{t.strikes}</span>
      <div class="bb-dots" id="bb-dots-strikes">
        <span class="bb-dot"></span><span class="bb-dot"></span><span class="bb-dot"></span>
      </div>
    </div>
    <div class="bb-count-item">
      <span class="bb-count-label">{t.outs}</span>
      <div class="bb-dots" id="bb-dots-outs">
        <span class="bb-dot bb-dot-out"></span><span class="bb-dot bb-dot-out"></span><span class="bb-dot bb-dot-out"></span>
      </div>
    </div>
  </div>

  <div class="bb-main-grid">
    <div class="bb-diamond-zone">
      <svg class="bb-diamond-svg" viewBox="0 0 200 200">
        <polygon class="bb-diamond-bg" points="100,10 190,100 100,190 10,100" />
        <circle class="bb-base bb-base-first" id="bb-base-first" cx="160" cy="130" r="18" />
        <circle class="bb-base bb-base-second" id="bb-base-second" cx="100" cy="40" r="18" />
        <circle class="bb-base bb-base-third" id="bb-base-third" cx="40" cy="130" r="18" />
        <text class="bb-base-label" x="160" y="135">1B</text>
        <text class="bb-base-label" x="100" y="45">2B</text>
        <text class="bb-base-label" x="40" y="135">3B</text>
        <circle class="bb-home-plate" cx="100" cy="178" r="10" />
        <text class="bb-base-label" x="100" y="183">H</text>
      </svg>
    </div>
    <div class="bb-rhe-box">
      <table class="bb-rhe-table">
        <thead>
          <tr><th></th><th>{t.runs}</th><th>{t.hits}</th><th>{t.errors}</th></tr>
        </thead>
        <tbody>
          <tr><td class="bb-rhe-team" id="bb-rhe-away-label">{t.away}</td><td id="bb-rhe-away-r">0</td><td id="bb-rhe-away-h">0</td><td id="bb-rhe-away-e">0</td></tr>
          <tr><td class="bb-rhe-team" id="bb-rhe-home-label">{t.home}</td><td id="bb-rhe-home-r">0</td><td id="bb-rhe-home-h">0</td><td id="bb-rhe-home-e">0</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="bb-inning-grid" id="bb-inning-grid">
    <div class="bb-inning-header">
      <span class="bb-inning-header-team"></span>
      <span class="bb-inning-header-cell">1</span>
      <span class="bb-inning-header-cell">2</span>
      <span class="bb-inning-header-cell">3</span>
      <span class="bb-inning-header-cell">4</span>
      <span class="bb-inning-header-cell">5</span>
      <span class="bb-inning-header-cell">6</span>
      <span class="bb-inning-header-cell">7</span>
      <span class="bb-inning-header-cell">8</span>
      <span class="bb-inning-header-cell">9</span>
    </div>
    <div class="bb-inning-row" id="bb-inning-row-away">
      <span class="bb-inning-row-team" id="bb-inning-row-away-label">{t.away}</span>
    </div>
    <div class="bb-inning-row" id="bb-inning-row-home">
      <span class="bb-inning-row-team" id="bb-inning-row-home-label">{t.home}</span>
    </div>
  </div>

  <div class="bb-btn-row">
    <button class="bb-btn bb-btn-strike" id="bb-btn-strike">{t.strikeBtn}</button>
    <button class="bb-btn bb-btn-ball" id="bb-btn-ball">{t.ballBtn}</button>
    <button class="bb-btn bb-btn-foul" id="bb-btn-foul">{t.foulBtn}</button>
    <button class="bb-btn bb-btn-hit" id="bb-btn-hit">{t.hitBtn}</button>
    <button class="bb-btn bb-btn-out" id="bb-btn-out">{t.outBtn}</button>
  </div>

  <div class="bb-actions">
    <button class="bb-btn bb-btn-reset" id="bb-btn-reset">{t.resetMatch}</button>
  </div>

  <div class="bb-reset-modal" id="bb-modal">
    <div class="bb-modal-content">
      <div class="bb-modal-text">{t.resetConfirm}</div>
      <div class="bb-modal-btns">
        <button class="bb-btn bb-btn-modal-cancel" id="bb-modal-cancel">{t.cancel}</button>
        <button class="bb-btn bb-btn-modal-confirm" id="bb-modal-confirm">{t.confirm}</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { initBaseballScorekeeper } from './ui-init';
  initBaseballScorekeeper();
</script>
