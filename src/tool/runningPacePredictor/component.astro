---
import type { RunningPacePredictorUI } from './ui';
import './running-pace-predictor.css';

interface Props {
  ui: RunningPacePredictorUI;
}

const { ui } = Astro.props;
---

<div class="rpp-container">
  <div class="rpp-unit-switch-container">
    <button class="rpp-btn-unit active" data-unit="km">{ui.unitKm}</button>
    <button class="rpp-btn-unit" data-unit="mi">{ui.unitMiles}</button>
  </div>

  <div class="rpp-calculator-card">
    <div class="rpp-card-header">
      <h2 class="rpp-card-title">{ui.paceCalculatorTitle}</h2>
    </div>

    <div class="rpp-presets-bar">
      <span class="rpp-presets-title">{ui.presetsTitle}:</span>
      <button class="rpp-btn-preset" data-dist="5">5K</button>
      <button class="rpp-btn-preset active" data-dist="10">10K</button>
      <button class="rpp-btn-preset" data-dist="21.0975">Half Marathon</button>
      <button class="rpp-btn-preset" data-dist="42.195">Marathon</button>
    </div>

    <div class="rpp-inputs-grid">
      <div class="rpp-custom-dist-container">
        <div style="flex:1;">
          <div class="rpp-stepper-title">{ui.distanceLabel}</div>
          <input type="number" id="rpp-distance" class="rpp-custom-dist-input" value="10" step="0.01" min="0.1" aria-label={ui.distanceLabel} />
        </div>
        <span class="rpp-custom-dist-unit" id="rpp-dist-unit-label">km</span>
      </div>

      <div class="rpp-stepper-card">
        <div class="rpp-stepper-header">
          <span class="rpp-stepper-title">{ui.timeLabel}</span>
          <span class="rpp-stepper-value" id="rpp-time-display">00:50:00</span>
        </div>

        <input type="hidden" id="rpp-total-seconds" value="3000" />

        <div class="rpp-stepper-controls">
          <button class="rpp-btn-step" data-step="-300">-5m</button>
          <button class="rpp-btn-step" data-step="-60">-1m</button>
          <button class="rpp-btn-step" data-step="60">+1m</button>
          <button class="rpp-btn-step" data-step="300">+5m</button>
        </div>
      </div>
    </div>

    <div class="rpp-hero-pace-card">
      <div class="rpp-hero-pace-label">{ui.paceLabel}</div>
      <div class="rpp-hero-pace-value" id="rpp-hero-pace-display">5:00 min/km</div>
    </div>
  </div>

  <div class="rpp-predictions-section">
    <h3 class="rpp-section-title">{ui.racePredictorTitle}</h3>
    <p class="rpp-section-subtitle">{ui.riegelExplanation}</p>
    <div class="rpp-pred-grid" id="rpp-predictions-cards"></div>
  </div>

  <div class="rpp-zones-section">
    <h3 class="rpp-section-title">{ui.trainingZonesTitle}</h3>
    <div class="rpp-zones-grid" id="rpp-zones-cards"></div>
  </div>
</div>

<script>
  import {
    calculatePaceFromTimeAndDistance,
    generateAllRacePredictions,
    calculateTrainingZones,
    formatPace,
    formatTimeHMS,
  } from './logic';

  let currentUnit = 'km';

  function renderPredictions(predictions: ReturnType<typeof generateAllRacePredictions>, isMiles: boolean, unitStr: string) {
    const predCards = document.getElementById('rpp-predictions-cards');
    if (!predCards) return;
    const maxDist = 42.195;
    predCards.innerHTML = predictions
      .map((p) => {
        const pDistStr = isMiles ? `${p.distanceMiles.toFixed(2)} mi` : `${p.distanceKm.toFixed(2)} km`;
        const pPace = isMiles ? formatPace(p.paceSecPerMile) : formatPace(p.paceSecPerKm);
        const percent = Math.min(100, Math.round((p.distanceKm / maxDist) * 100));
        return `
          <div class="rpp-pred-card">
            <div class="rpp-pred-card-top">
              <div>
                <div class="rpp-pred-dist">${p.id.toUpperCase()} <span style="font-size:0.8rem; color:#94a3b8; font-weight:600;">(${pDistStr})</span></div>
                <div style="font-size:0.85rem; color:#94a3b8; font-weight:700; margin-top:0.1rem;">${pPace} ${unitStr}</div>
              </div>
              <div class="rpp-pred-time">${formatTimeHMS(p.timeSeconds)}</div>
            </div>
            <div class="rpp-pred-bar-bg">
              <div class="rpp-pred-bar-fill" style="width: ${percent}%;"></div>
            </div>
          </div>
        `;
      })
      .join('');
  }

  function renderZones(fiveKPace: number, isMiles: boolean, unitStr: string) {
    const zonesCards = document.getElementById('rpp-zones-cards');
    if (!zonesCards) return;
    const zones = calculateTrainingZones(fiveKPace);
    zonesCards.innerHTML = zones
      .map((z) => {
        const minP = isMiles ? formatPace(z.minPaceSecPerMile) : formatPace(z.minPaceSecPerKm);
        const maxP = isMiles ? formatPace(z.maxPaceSecPerMile) : formatPace(z.maxPaceSecPerKm);
        return `
          <div class="rpp-zone-card">
            <div class="rpp-zone-header">
              <span class="rpp-zone-pill rpp-zone-pill-${z.id}">${z.id.toUpperCase()}</span>
              <span class="rpp-zone-range">${minP} - ${maxP} ${unitStr}</span>
            </div>
            <div class="rpp-zone-bar-bg">
              <div class="rpp-zone-bar-${z.id}"></div>
            </div>
          </div>
        `;
      })
      .join('');
  }

  function getCoreInputs() {
    const distInput = document.getElementById('rpp-distance') as HTMLInputElement | null;
    const secInput = document.getElementById('rpp-total-seconds') as HTMLInputElement | null;
    if (!distInput || !secInput) return null;

    const isMiles = currentUnit === 'mi';
    const rawDist = parseFloat(distInput.value) || 0;
    const totalSec = Math.max(0, parseInt(secInput.value) || 0);

    return {
      distKm: isMiles ? rawDist * 1.609344 : rawDist,
      totalSec,
      isMiles,
    };
  }

  function updateApp() {
    const inputs = getCoreInputs();
    const timeDisplay = document.getElementById('rpp-time-display');
    const heroPaceDisplay = document.getElementById('rpp-hero-pace-display');
    const distUnitLabel = document.getElementById('rpp-dist-unit-label');

    if (!inputs || !timeDisplay || !heroPaceDisplay || !distUnitLabel) return;

    distUnitLabel.textContent = inputs.isMiles ? 'miles' : 'km';
    timeDisplay.textContent = formatTimeHMS(inputs.totalSec);

    const pace = calculatePaceFromTimeAndDistance(inputs.totalSec, inputs.distKm);
    const mainPaceFormatted = inputs.isMiles ? formatPace(pace.secPerMile) : formatPace(pace.secPerKm);
    const unitStr = inputs.isMiles ? 'min/mile' : 'min/km';
    heroPaceDisplay.textContent = `${mainPaceFormatted} ${unitStr}`;

    const predictions = generateAllRacePredictions(inputs.distKm, inputs.totalSec);
    renderPredictions(predictions, inputs.isMiles, unitStr);

    const fiveKPred = predictions.find((p) => p.id === '5k');
    renderZones(fiveKPred ? fiveKPred.paceSecPerKm : pace.secPerKm, inputs.isMiles, unitStr);
  }

  const STORAGE_KEY = 'rpp_user_state';

  function saveState() {
    try {
      const distInput = document.getElementById('rpp-distance') as HTMLInputElement;
      const secInput = document.getElementById('rpp-total-seconds') as HTMLInputElement;
      const activePreset = document.querySelector('.rpp-btn-preset.active')?.getAttribute('data-dist') || null;

      const state = {
        unit: currentUnit,
        distance: distInput ? distInput.value : '10',
        totalSeconds: secInput ? secInput.value : '3000',
        activePreset,
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch {
      return;
    }
  }

  function applySavedInputs(state: { unit?: string; distance?: string; totalSeconds?: string; activePreset?: string }) {
    if (state.unit) {
      currentUnit = state.unit;
      document.querySelectorAll('.rpp-btn-unit').forEach((b) => {
        b.classList.toggle('active', b.getAttribute('data-unit') === currentUnit);
      });
    }
    if (state.distance) {
      const distIn = document.getElementById('rpp-distance') as HTMLInputElement;
      if (distIn) distIn.value = state.distance;
    }
    if (state.totalSeconds) {
      const secInput = document.getElementById('rpp-total-seconds') as HTMLInputElement;
      if (secInput) secInput.value = state.totalSeconds;
    }
    if (state.activePreset) {
      document.querySelectorAll('.rpp-btn-preset').forEach((b) => {
        b.classList.toggle('active', b.getAttribute('data-dist') === state.activePreset);
      });
    }
  }

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        applySavedInputs(JSON.parse(raw));
      }
    } catch {
      return;
    }
  }

  function bindDistAndStepEvents(onDistChange: () => void) {
    const distInput = document.getElementById('rpp-distance');
    if (distInput) {
      distInput.addEventListener('input', onDistChange);
      distInput.addEventListener('change', onDistChange);
    }
    document.querySelectorAll('.rpp-btn-step').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const delta = parseInt((e.currentTarget as HTMLElement).getAttribute('data-step') || '0');
        const secInput = document.getElementById('rpp-total-seconds') as HTMLInputElement;
        if (secInput) {
          secInput.value = Math.max(0, (parseInt(secInput.value) || 0) + delta).toString();
          onDistChange();
        }
      });
    });
  }

  function onUnitBtnClick(e: Event, onDistChange: () => void) {
    const target = e.currentTarget as HTMLElement;
    const selectedUnit = target.getAttribute('data-unit') || 'km';
    if (selectedUnit === currentUnit) return;

    document.querySelectorAll('.rpp-btn-unit').forEach((b) => b.classList.remove('active'));
    target.classList.add('active');

    const distIn = document.getElementById('rpp-distance') as HTMLInputElement;
    if (distIn) {
      const currentVal = parseFloat(distIn.value) || 0;
      distIn.value = selectedUnit === 'mi' ? (currentVal / 1.609344).toFixed(2) : (currentVal * 1.609344).toFixed(2);
    }

    currentUnit = selectedUnit;
    onDistChange();
  }

  function onPresetBtnClick(e: Event, onDistChange: () => void) {
    const target = e.currentTarget as HTMLElement;
    document.querySelectorAll('.rpp-btn-preset').forEach((b) => b.classList.remove('active'));
    target.classList.add('active');

    const distKm = parseFloat(target.getAttribute('data-dist') || '0');
    const distIn = document.getElementById('rpp-distance') as HTMLInputElement;
    if (distIn && distKm > 0) {
      distIn.value = currentUnit === 'mi' ? (distKm / 1.609344).toFixed(2) : distKm.toString();
      onDistChange();
    }
  }

  function bindEventListeners() {
    const onDistChange = () => {
      updateApp();
      saveState();
    };
    bindDistAndStepEvents(onDistChange);
    document.querySelectorAll('.rpp-btn-unit').forEach((b) => b.addEventListener('click', (e) => onUnitBtnClick(e, onDistChange)));
    document.querySelectorAll('.rpp-btn-preset').forEach((b) => b.addEventListener('click', (e) => onPresetBtnClick(e, onDistChange)));
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadState();
    bindEventListeners();
    updateApp();
  });
</script>
