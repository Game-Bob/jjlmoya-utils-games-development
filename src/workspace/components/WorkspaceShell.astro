---
import ProjectBar from './ProjectBar.astro';
import ProjectLauncher from './ProjectLauncher.astro';
import PipelineSidebar from './PipelineSidebar.astro';
import ToolViewport from './ToolViewport.astro';
import OutputStatusDock from './OutputStatusDock.astro';
import '../styles/workspace.css';

interface Props {
  productName?: string;
}

const { productName = 'GameBob Quest' } = Astro.props;
---

<div id="workspace-root" class="workspace-shell" data-testid="workspace-shell" data-workspace-mode="launcher">
  <ProjectBar productName={productName} />

  <div class="workspace-body">
    <ProjectLauncher />
    <div id="workspace-workbench" class="workspace-workbench" hidden>
      <PipelineSidebar />

      <div class="workspace-viewport-area">
        <ToolViewport />
        <OutputStatusDock />
      </div>
    </div>
  </div>
</div>

<script>
  import { WorkspaceStateManager } from '../state/WorkspaceStateManager';
  import { WorkspaceShellController } from '../client/WorkspaceShellController';
  import { configureDesktopPlatformBridge } from '../../platform/desktop';
  import { resolvePlatformBridge } from '../../platform/resolver';

  function initWorkspace(): void {
    const root = document.getElementById('workspace-root');
    if (!root) {
      return;
    }

    configureDesktopPlatformBridge();
    const state = new WorkspaceStateManager();
    const controller = new WorkspaceShellController(root, state, resolvePlatformBridge());
    controller.init();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWorkspace);
  } else {
    initWorkspace();
  }
</script>
