<section id="project-launcher" class="project-launcher" aria-labelledby="launcher-title">
  <div class="launcher-content">
    <span class="launcher-eyebrow">GameBob Quest Desktop</span>
    <h2 id="launcher-title">Your next session starts here.</h2>
    <p class="launcher-intro">Open a game project to keep your tools, files, and work together.</p>

    <div class="launcher-primary-actions">
      <button id="launcher-open" class="launcher-action launcher-action-primary" type="button">Open project</button>
      <button id="launcher-new" class="launcher-action" type="button">Create project</button>
    </div>

    <p id="launcher-error" class="launcher-error" role="alert" hidden></p>

    <div class="launcher-labs">
      <div>
        <span class="launcher-labs-label">Just exploring?</span>
        <p>Use individual tools without connecting a project. Your work will not be part of a project session.</p>
      </div>
      <button id="launcher-labs" class="launcher-labs-button" type="button">Open Labs</button>
    </div>
  </div>
</section>
