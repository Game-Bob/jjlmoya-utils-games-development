<section id="project-explorer" class="project-explorer" aria-label="Project files" hidden>
  <div class="project-explorer-header">
    <span class="sidebar-title">Project files</span>
    <button id="project-explorer-refresh" class="project-explorer-refresh" type="button" aria-label="Refresh project files" title="Refresh project files">Refresh</button>
  </div>
  <div class="project-explorer-location">
    <button id="project-explorer-back" class="project-explorer-back" type="button" aria-label="Back to parent folder" title="Back to parent folder" disabled>Back</button>
    <span id="project-explorer-path" class="project-explorer-path"></span>
  </div>
  <div id="project-explorer-list" class="project-explorer-list" role="list"></div>
  <p id="project-explorer-status" class="project-explorer-status" role="status"></p>
</section>
