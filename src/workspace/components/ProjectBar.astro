---
interface Props {
  productName?: string;
}

const { productName = 'GameBob Quest' } = Astro.props;
---

<header class="project-bar" role="banner">
  <div class="project-bar-branding">
    <span class="project-bar-logo" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="6" width="20" height="12" rx="2"></rect>
        <path d="M6 12h4"></path>
        <path d="M8 10v4"></path>
        <circle cx="17" cy="10" r="1"></circle>
        <circle cx="15" cy="13" r="1"></circle>
      </svg>
    </span>
    <span class="project-bar-title">{productName}</span>
  </div>

  <details id="project-bar-file-menu" class="project-bar-file-menu">
    <summary>File</summary>
    <div class="project-bar-file-menu-panel">
      <button id="project-bar-new-btn" type="button">New project</button>
      <button id="project-bar-menu-open-btn" type="button">Open project</button>
      <button id="project-bar-save-as-btn" type="button">Save project as</button>
      <button id="project-bar-sync-btn" type="button" aria-pressed="false">Watch project changes</button>
    </div>
  </details>

  <div id="project-bar-summary" class="project-bar-summary" aria-label="Current project" hidden>
    <span id="project-bar-name" class="project-bar-name"></span>
    <span id="project-bar-path" class="project-bar-path"></span>
  </div>

  <div class="project-bar-actions">
    <button id="project-bar-open-btn" class="project-bar-btn" type="button" title="Open project (Ctrl+O)" aria-label="Open project">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
      </svg>
      <span>Open project</span>
    </button>
  </div>
</header>
