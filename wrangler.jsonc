{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "gamebob-utilities-games-development",
    "main": "src/worker.ts",
    "compatibility_date": "2026-07-22",
    "workers_dev": false,
    "preview_urls": true,
    "routes": [
