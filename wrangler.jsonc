        {
            "pattern": "www.gamebob.dev/_utilities/games-development/*",
            "zone_name": "gamebob.dev"
        },
        {
            "pattern": "www.jjlmoya.es/_utilities/games-development/*",
            "zone_name": "jjlmoya.es"
        }
